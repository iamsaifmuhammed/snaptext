{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapText",
  "version": "1.1.1",
  "identifier": "com.snaptext.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnapText",
        "width": 760,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Lightweight screenshot and text extraction utility",
    "longDescription": "A local-first desktop screenshot tool with OCR.",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
